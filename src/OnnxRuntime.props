<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MagpieOrtRoot>$(MSBuildThisFileDirectory)..\packages\Microsoft.ML.OnnxRuntime.DirectML.1.24.4</MagpieOrtRoot>
    <MagpieDmlRoot>$(MSBuildThisFileDirectory)..\packages\Microsoft.AI.DirectML.1.15.4</MagpieDmlRoot>
    <MagpieOrtArch Condition="'$(Platform)' == 'x64'">x64</MagpieOrtArch>
    <MagpieOrtArch Condition="'$(Platform)' == 'ARM64'">arm64</MagpieOrtArch>
    <!-- HybridCRT only applies to our own code. The prebuilt ORT DLL uses the
         dynamic VC runtime, which must also ship with portable builds. -->
    <MagpieVCRedistRoot Condition="'$(MagpieVCRedistRoot)' == ''">$(VCToolsRedistInstallDir)</MagpieVCRedistRoot>
    <MagpieVCRedistRoot Condition="'$(MagpieVCRedistRoot)' == ''">$(VCToolsRedistDir)</MagpieVCRedistRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MagpieOrtRoot)\build\native\include;$(MagpieDmlRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(MagpieOrtRoot)\runtimes\win-$(MagpieOrtArch)\native\onnxruntime.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(ConfigurationType)' == 'Application'">
    <_MagpieVCRuntime Include="$(MagpieVCRedistRoot)\$(MagpieOrtArch)\Microsoft.VC*.CRT\*.dll" Condition="'$(MagpieVCRedistRoot)' != ''" />
    <Content Include="@(_MagpieVCRuntime)">
      <Link>%(Filename)%(Extension)</Link>
      <DeploymentContent>true</DeploymentContent>
    </Content>
    <Content Include="$(MagpieOrtRoot)\runtimes\win-$(MagpieOrtArch)\native\onnxruntime.dll;$(MagpieOrtRoot)\runtimes\win-$(MagpieOrtArch)\native\onnxruntime_providers_shared.dll;$(MagpieDmlRoot)\bin\$(MagpieOrtArch)-win\DirectML.dll">
      <Link>%(Filename)%(Extension)</Link>
      <DeploymentContent>true</DeploymentContent>
    </Content>
  </ItemGroup>
  <Target Name="CheckMagpieOnnxRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MagpieOrtArch)' == ''" Text="Magpie's ONNX backend requires x64 or ARM64." />
    <Error Condition="!Exists('$(MagpieOrtRoot)\build\native\include\onnxruntime_cxx_api.h') Or !Exists('$(MagpieDmlRoot)\include\DirectML.h')" Text="Restore the ONNX Runtime DirectML and DirectML NuGet packages before building." />
    <Error Condition="'$(ConfigurationType)' == 'Application' And '@(_MagpieVCRuntime)' == ''" Text="VC runtime redistributables were not found. Install the MSVC C++ redistributable tools, or set MagpieVCRedistRoot to the Visual Studio Redist\MSVC\version directory. Portable ONNX builds must include the target architecture's CRT DLLs." />
  </Target>
  <Target Name="CopyMagpieOnnxRuntime" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <ItemGroup>
      <_MagpieOnnxDll Include="$(MagpieOrtRoot)\runtimes\win-$(MagpieOrtArch)\native\onnxruntime.dll" />
      <_MagpieOnnxDll Include="$(MagpieOrtRoot)\runtimes\win-$(MagpieOrtArch)\native\onnxruntime_providers_shared.dll" />
      <_MagpieOnnxDll Include="$(MagpieDmlRoot)\bin\$(MagpieOrtArch)-win\DirectML.dll" />
      <_MagpieOnnxDll Include="@(_MagpieVCRuntime)" />
    </ItemGroup>
    <Copy SourceFiles="@(_MagpieOnnxDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
